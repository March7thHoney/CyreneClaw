{
  "discord": {
    "token": "在此填写 Discord Bot Token",
    "proxy": "http://127.0.0.1:1082",
    "owner": {
      "userId": "在此填写你的 Discord 用户 ID",
      "displayName": "在此填写角色该怎么称呼你"
    },
    "dm": {
      "enabled": true
    },
    "groupPolicy": "allowlist",
    "guilds": {
      "在此填写服务器 ID": {
        "requireMention": true,
        "channels": null
      }
    },
    "cadence": {
      "enabled": true,
      "replyEveryN": 10
    },
    "schedule": [
      {
        "enabled": false,
        "time": "12:00",
        "text": "（每天这个时刻原样发出的话，用角色口吻写）",
        "channels": [
          "在此填写频道 ID"
        ]
      }
    ],
    "ambient": {
      "enabled": true,
      "maxMessages": 15,
      "maxCharsPerMessage": 200,
      "maxTotalChars": 1500,
      "retentionMinutes": 30
    },
    "typing": {
      "intervalMs": 8000,
      "maxMs": 900000
    },
    "send": {
      "maxChars": 1900,
      "delayMs": 400,
      "retry": {
        "attempts": 3,
        "minDelayMs": 1000,
        "maxDelayMs": 30000
      }
    },
    "debounceMs": 1500,
    "clearCommandName": "清空",
    "replies": {
      "notOwner": "（仅主人可用该命令时的提示语，用角色口吻写）",
      "cleared": "（清空成功时的提示语，用角色口吻写）",
      "nothingToClear": "（本来就没有记忆时的提示语）",
      "error": "（生成失败时的提示语）"
    }
  },
  "sillytavern": {
    "dataDir": "在此填写酒馆 data/default-user 目录的绝对路径",
    "characterFile": "characters/角色卡文件名.png",
    "presetFile": "OpenAI Settings/预设文件名.json",
    "worldBooks": [
      "worlds/世界书文件名.json"
    ]
  },
  "prompt": {
    "personaDescription": "在此填写 Discord 专用 persona，可用 {{user}} 与 {{char}} 宏",
    "promptPlaceholder": "[Start a new chat]",
    "wiFormat": "{0}\n",
    "scenarioFormat": "{{scenario}}",
    "personalityFormat": "{{personality}}",
    "namesBehavior": 0,
    "squashSystemMessages": true,
    "postProcessing": "strict",
    "maxContext": 127104,
    "maxTokens": 8192,
    "discordContract": "在此填写 Discord 输出契约，见 README",
    "tailContract": "在此填写长度契约，会追加到整段提示词的最后，见 README",
    "worldInfo": {
      "depth": 2,
      "budgetPercent": 25,
      "budgetCap": 4000,
      "recursive": true,
      "matchWholeWords": true,
      "caseSensitive": false,
      "includeNames": true,
      "characterStrategy": 1,
      "scanAmbient": false,
      "scanReplyContext": true
    }
  },
  "llm": {
    "baseUrl": "http://127.0.0.1:5599/v1",
    "apiKey": "",
    "model": "claude-opus-5",
    "stop": [
      "\nHuman:",
      "\nAssistant:"
    ],
    "timeoutMs": 600000,
    "maxConcurrent": 1
  },
  "chat": {
    "dataDir": "./data",
    "seedFirstMes": true,
    "sendGreetingOnNewScope": false,
    "maxLines": 2000
  },
  "format": {
    "onNoDialogue": "skip",
    "joinSeparator": " ",
    "dropUnclosedComment": true,
    "redact": {
      "enabled": true,
      "emails": true,
      "extraPatterns": []
    }
  },
  "voice": {
    "enabled": false,
    "endpoint": "http://127.0.0.1:9880",
    "dir": "./voice",
    "python": "~/miniconda3/envs/GPTSoVits/bin/python",
    "autoStart": true,
    "device": "cpu",
    "model": {
      "dir": "model/v2ProPlus/角色目录名",
      "gpt": "GPT 权重文件名.ckpt",
      "sovits": "SoVITS 权重文件名.pth",
      "refAudio": "reference_audios/中文/emotions/参考音频文件名.wav",
      "refText": "参考音频对应的文本，要和音频内容一字不差",
      "refLang": "zh"
    },
    "synth": {
      "textLanguage": "zh",
      "topK": 15,
      "topP": 1.0,
      "temperature": 1.0,
      "speed": 1.0,
      "sampleSteps": 16,
      "ifSr": false
    },
    "minChars": 2,
    "maxChars": 240,
    "replyTo": "none",
    "warmupOnStart": true,
    "keepServiceAlive": true,
    "readyTimeoutMs": 180000,
    "synthTimeoutMs": 180000,
    "queueMax": 3,
    "shutdownWaitMs": 5000,
    "cleanupHours": 24,
    "ffmpeg": "",
    "ffprobe": ""
  },
  "tokenizer": "o200k",
  "log": {
    "level": "info",
    "dir": "./logs",
    "logPrompts": false
  }
}
